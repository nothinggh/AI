import streamlit as st
import sqlite3
import pandas as pd
from datetime import datetime
import random

DB_PATH = "/home/gram/work/pipe_mes/sql/pipe_mes.db"

def init_db():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute('''
        CREATE TABLE IF NOT EXISTS MFP (
            lot_id INTEGER PRIMARY KEY AUTOINCREMENT,
            lot_number TEXT,
            ship_no TEXT,
            drawing_type TEXT,
            drawing_no TEXT,
            vendor_name TEXT,
            factory TEXT,
            receipt_date TEXT,
            weight REAL,
            status TEXT,
            start_datetime TEXT,
            end_datetime TEXT,
            lead_time REAL,
            issue_type TEXT,
            issue_desc TEXT,
            worker TEXT,
            manager TEXT
        )
    ''')
    conn.commit()
    conn.close()

init_db()

st.markdown("""
<style>
    .stTextInput input, .stNumberInput input, .stSelectbox select, .stDateInput input, .stTimeInput input {
        font-size: 11px !important;
        padding: 2px 5px !important;
