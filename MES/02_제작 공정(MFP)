import random
import sqlite3
from datetime import datetime
import pandas as pd
import streamlit as st

DB_PATH = "/home/gram/work/pipe_mes/sql/pipe_mes.db"


def init_db():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute(
        """
        CREATE TABLE IF NOT EXISTS MFP (
            lot_id INTEGER PRIMARY KEY AUTOINCREMENT,
            lot_no TEXT,
            ship_no TEXT,
            draw_type TEXT,
            draw_no TEXT,
            vendor TEXT,
            factory TEXT,
            receipt_date TEXT,
            status TEXT,
            start_datetime TEXT,
            end_datetime TEXT,
            elapsed_hours REAL,
            issue_type TEXT,
            issue_detail TEXT,
            worker TEXT,
            manager TEXT
        )
    """
    )
    conn.commit()
    conn.close()


init_db()

st.markdown(
    """
