</style>
""", unsafe_allow_html=True)

st.markdown("---")
st.title("제작 공정(MFP)")
st.markdown("##### (Manufacturing Process)")
st.markdown("---")

tab = st.radio("", ["1. 제작 공정 등록", "2. 제작 공정 관리"], horizontal=True)

if tab == "1. 제작 공정 등록":
    with st.form("register_form"):
        col1, col2, col3 = st.columns(3)
        with col1:
            ship_no = st.text_input("호선 번호").upper()
            drawing_type = st.text_input("도면 종류").upper()
            drawing_no = st.text_input("도면 번호").upper()
            vendor_name = st.text_input("제작 업체명").upper()
            factory = st.selectbox("배치 공장", ["공장A", "공장B", "공장C"])
        with col2:
            receipt_date = st.date_input("제작 도면 접수 일자")
            weight = st.number_input("중량", min_value=0.0, step=0.1)
            status = st.selectbox("제작 진행 상황", ["제작 중", "재 제작", "보류", "완료", "출고"])
            start_d = st.date_input("제작 시작 날짜")
            start_t = st.time_input("제작 시작 시간")
        with col3:
            end_d = st.date_input("제작 완료 날짜")
            end_t = st.time_input("제작 완료 시간")
            issue_type = st.selectbox("제작 문제", ["없음", "파손", "불량", "오작"])
            issue_desc = st.text_input("이슈").upper()
            worker = st.text_input("작업자").upper()
            manager = st.text_input("관리자").upper()

        start_dt = datetime.combine(start_d, start_t)
        end_dt = datetime.combine(end_d, end_t)
        lead_time = max(0.0, round((end_dt - start_dt).total_seconds() / 3600.0, 2))
        st.text_input("실 투입 시간(시간)", value=str(lead_time), disabled=True)

        submitted = st.form_submit_button("등록")
        if submitted:
            today_str = datetime.now().strftime("%Y%m%d")
            rand_4 = f"{random.randint(0, 9999):04d}"
            lot_number = f"{ship_no}-{drawing_type}-{vendor_name}-{today_str}-{rand_4}"

            conn = sqlite3.connect(DB_PATH)
            c = conn.cursor()
            c.execute('''
                INSERT INTO MFP (
                    lot_number, ship_no, drawing_type, drawing_no, vendor_name,
                    factory, receipt_date, weight, status, start_datetime,
                    end_datetime, lead_time, issue_type, issue_desc, worker, manager
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ''', (
                lot_number, ship_no, drawing_type, drawing_no, vendor_name,
                factory, str(receipt_date), weight, status, str(start_dt),
                str(end_dt), lead_time, issue_type, issue_desc, worker, manager
            ))
            conn.commit()
            conn.close()
            st.success("등록 완료")

elif tab == "2. 제작 공정 관리":
    conn = sqlite3.connect(DB_PATH)
    df = pd.read_sql_query("SELECT * FROM MFP", conn)
    conn.close()

    if not df.empty:
        col_s1, col_s2 = st.columns([1, 3])
        with col_s1:
            search_col = st.selectbox("검색 항목", ["전체"] + list(df.columns))
        with col_s2:
            search_kw = st.text_input("검색어").upper()

        if search_kw:
            if search_col == "전체":
                mask = df.astype(str).apply(lambda x: x.str.contains(search_kw, case=False)).any(axis=1)
            else:
                mask = df[search_col].astype(str).str.contains(search_kw, case=False)
            df_filtered = df[mask]
        else:
            df_filtered = df

        col_b1, col_b2 = st.columns(2)
        with col_b1:
            select_all = st.checkbox("전체 선택")
        
        selected_ids = []
        
        for idx, row in df_filtered.iterrows():
            c1, c2 = st.columns([0.5, 11.5])
            with c1:
                chk = st.checkbox("", value=select_all, key=f"chk_{row['lot_id']}")
                if chk:
                    selected_ids.append(row['lot_id'])
            with c2:
                with st.expander(f"LOT ID: {row['lot_id']} | LOT NO: {row['lot_number']}"):
                    with st.form(f"edit_form_{row['lot_id']}"):
                        ec1, ec2, ec3 = st.columns(3)
                        with ec1:
                            u_ship_no = st.text_input("호선 번호", value=str(row['ship_no'])).upper()
                            u_drawing_type = st.text_input("도면 종류", value=str(row['drawing_type'])).upper()
                            u_drawing_no = st.text_input("도면 번호", value=str(row['drawing_no'])).upper()
                            u_vendor_name = st.text_input("제작 업체명", value=str(row['vendor_name'])).upper()
                            u_factory = st.selectbox("배치 공장", ["공장A", "공장B", "공장C"], index=["공장A", "공장B", "공장C"].index(row['factory']) if row['factory'] in ["공장A", "공장B", "공장C"] else 0)
                        with ec2:
                            u_receipt_date = st.date_input("제작 도면 접수 일자", value=datetime.strptime(row['receipt_date'], "%Y-%m-%d") if row['receipt_date'] else datetime.now())
                            u_weight = st.number_input("중량", value=float(row['weight']) if row['weight'] else 0.0, min_value=0.0, step=0.1)
                            u_status = st.selectbox("제작 진행 상황", ["제작 중", "재 제작", "보류", "완료", "출고"], index=["제작 중", "재 제작", "보류", "완료", "출고"].index(row['status']) if row['status'] in ["제작 중", "재 제작", "보류", "완료", "출고"] else 0)
                            
                            cur_start = datetime.strptime(row['start_datetime'], "%Y-%m-%d %H:%M:%S") if row['start_datetime'] else datetime.now()
                            u_start_d = st.date_input("제작 시작 날짜", value=cur_start.date(), key=f"sd_{row['lot_id']}")
                            u_start_t = st.time_input("제작 시작 시간", value=cur_start.time(), key=f"st_{row['lot_id']}")
                        with ec3:
                            cur_end = datetime.strptime(row['end_datetime'], "%Y-%m-%d %H:%M:%S") if row['end_datetime'] else datetime.now()
                            u_end_d = st.date_input("제작 완료 날짜", value=cur_end.date(), key=f"ed_{row['lot_id']}")
                            u_end_t = st.time_input("제작 완료 시간", value=cur_end.time(), key=f"et_{row['lot_id']}")
                            u_issue_type = st.selectbox("제작 문제", ["없음", "파손", "불량", "오작"], index=["없음", "파손", "불량", "오작"].index(row['issue_type']) if row['issue_type'] in ["없음", "파손", "불량", "오작"] else 0)
                            u_issue_desc = st.text_input("이슈", value=str(row['issue_desc'])).upper()
                            u_worker = st.text_input("작업자", value=str(row['worker'])).upper()
                            u_manager = st.text_input("관리자", value=str(row['manager'])).upper()

                        u_start_dt = datetime.combine(u_start_d, u_start_t)
                        u_end_dt = datetime.combine(u_end_d, u_end_t)
                        u_lead_time = max(0.0, round((u_end_dt - u_start_dt).total_seconds() / 3600.0, 2))
                        st.text_input("실 투입 시간(시간)", value=str(u_lead_time), disabled=True, key=f"lt_{row['lot_id']}")

                        update_btn = st.form_submit_button("수정")
                        if update_btn:
                            conn = sqlite3.connect(DB_PATH)
                            c = conn.cursor()
                            c.execute('''
                                UPDATE MFP SET
                                    ship_no=?, drawing_type=?, drawing_no=?, vendor_name=?,
                                    factory=?, receipt_date=?, weight=?, status=?, start_datetime=?,
                                    end_datetime=?, lead_time=?, issue_type=?, issue_desc=?, worker=?, manager=?
                                WHERE lot_id=?
                            ''', (
                                u_ship_no, u_drawing_type, u_drawing_no, u_vendor_name,
                                u_factory, str(u_receipt_date), u_weight, u_status, str(u_start_dt),
                                str(u_end_dt), u_lead_time, u_issue_type, u_issue_desc, u_worker, u_manager, row['lot_id']
                            ))
                            conn.commit()
                            conn.close()
                            st.success("수정 완료")
                            st.rerun()

        if st.button("선택 항목 삭제"):
            if selected_ids:
                conn = sqlite3.connect(DB_PATH)
                c = conn.cursor()
                c.execute(f"DELETE FROM MFP WHERE lot_id IN ({','.join(['?']*len(selected_ids))})", selected_ids)
                conn.commit()
                conn.close()
                st.success("삭제 완료")
                st.rerun()
            else:
                st.warning("선택된 항목이 없습니다.")
    else:
        st.info("데이터가 없습니다.")
