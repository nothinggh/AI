MATERIALS = ["Steel", "Sus", "Copper", "Asbestos", "Rubber"]
ITEMS = [
    "Pipe(6M)",
    "Flange",
    "Coupling",
    "Bolt",
    "Nut",
    "Gasket",
    "Elbow",
    "Tee",
]

if tab == "1. 자재 주문 등록":
    c1, c2 = st.columns(2)
    with c1:
        order_user_id = st.text_input("주문자 ID").upper()
        ship_no = st.text_input("호선 번호").upper()
        item_type = st.selectbox("자재 종류", ITEMS)
        material = st.selectbox("재질", MATERIALS)

    if material in ["Steel", "Sus"]:
        valid_sizes = [s for s in SIZES if s not in ["8A", "10A"]]
    elif material == "Copper":
        valid_sizes = ["8A", "10A"]
    else:
        valid_sizes = SIZES

    with c2:
        size = st.selectbox("SIZE", valid_sizes)
        quantity = st.number_input("수량", min_value=1, value=1, step=1)
        order_date = st.date_input("주문 날짜", value=date.today())

    calc_weight = WEIGHT_DATA.get(item_type, {}).get(size, 0.0) * quantity
    calc_price = PRICE_DATA.get(item_type, {}).get(size, 0.0) * quantity

    c3, c4 = st.columns(2)
    with c3:
        st.text_input("중량 (개당 기준 총 중량)", value=f"{calc_weight:.2f}", disabled=True)
    with c4:
        st.text_input("가격 (개당 기준 총 가격)", value=f"{calc_price:,.0f}", disabled=True)

    request_note = st.text_input("요청 사항").upper()

    if st.button("등록"):
        if not order_user_id or not ship_no:
            st.error("주문자 ID와 호선 번호를 입력하세요.")
        else:
            conn = sqlite3.connect(DB_PATH)
            c = conn.cursor()
            c.execute(
                """
                INSERT INTO BOM (order_user_id, ship_no, item_type, material, size, quantity, weight, price, order_date, request_note)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """,
                (
                    order_user_id,
                    ship_no,
                    item_type,
                    material,
                    size,
                    quantity,
                    calc_weight,
                    calc_price,
                    str(order_date),
                    request_note,
                ),
            )
            conn.commit()
            conn.close()
            st.success("등록 완료")

elif tab == "2. 전체 주문 관리":
    conn = sqlite3.connect(DB_PATH)
    df = pd.read_sql_query("SELECT * FROM BOM", conn)
    conn.close()

    if df.empty:
        st.info("데이터가 없습니다.")
    else:
        s_col1, s_col2 = st.columns([1, 2])
        with s_col1:
            search_col = st.selectbox("검색 컬럼", ["전체"] + list(df.columns))
        with s_col2:
            search_term = st.text_input("검색어").upper()

        filtered_df = df.copy()
        if search_term:
            if search_col == "전체":
                mask = filtered_df.astype(str).apply(
                    lambda x: x.str.contains(search_term, case=False).any(),
                    axis=1,
                )
                filtered_df = filtered_df[mask]
            else:
                filtered_df = filtered_df[
                    filtered_df[search_col]
                    .astype(str)
                    .str.contains(search_term, case=False)
                ]

        btn_c1, btn_c2, _ = st.columns([1, 1, 4])
        with btn_c1:
            select_all = st.checkbox("전체 선택")
        with btn_c2:
            delete_btn = st.button("선택 삭제")

        if select_all:
            filtered_df["선택"] = True
        else:
            filtered_df["선택"] = False

        cols = ["선택"] + [c for c in filtered_df.columns if c != "선택"]
        filtered_df = filtered_df[cols]

        edited_df = st.data_editor(
            filtered_df,
            column_config={
                "선택": st.column_config.CheckboxColumn("선택", default=False),
                "id": st.column_config.NumberColumn("ID", disabled=True),
                "item_type": st.column_config.SelectboxColumn(
                    "자재 종류", options=ITEMS
                ),
                "material": st.column_config.SelectboxColumn(
                    "재질", options=MATERIALS
                ),
                "size": st.column_config.SelectboxColumn(
                    "SIZE", options=SIZES
                ),
            },
            disabled=["id"],
            hide_index=True,
            use_container_width=True,
        )

        if delete_btn:
            del_ids = edited_df[edited_df["선택"] == True]["id"].tolist()
            if del_ids:
                conn = sqlite3.connect(DB_PATH)
                c = conn.cursor()
                c.executemany(
                    "DELETE FROM BOM WHERE id = ?", [(i,) for i in del_ids]
                )
                conn.commit()
                conn.close()
                st.success("삭제 완료")
                st.rerun()

        if st.button("수정 사항 저장"):
            conn = sqlite3.connect(DB_PATH)
            c = conn.cursor()
            for idx, row in edited_df.iterrows():
                row_mat = row["material"]
                row_sz = row["size"]
                if row_mat in ["Steel", "Sus"] and row_sz in ["8A", "10A"]:
                    st.error(
                        f"ID {row['id']}: Steel/Sus 재질은 8A, 10A를 선택할 수 없습니다."
                    )
                    conn.close()
                    st.stop()
                if row_mat == "Copper" and row_sz not in ["8A", "10A"]:
                    st.error(
                        f"ID {row['id']}: Copper 재질은 8A, 10A만 선택 가능합니다."
                    )
                    conn.close()
                    st.stop()

                u_id = str(row["order_user_id"]).upper()
                u_ship = str(row["ship_no"]).upper()
                u_req = str(row["request_note"]).upper()

                c.execute(
                    """
                    UPDATE BOM
                    SET order_user_id = ?, ship_no = ?, item_type = ?, material = ?, size = ?, quantity = ?, weight = ?, price = ?, order_date = ?, request_note = ?
                    WHERE id = ?
                """,
                    (
                        u_id,
                        u_ship,
                        row["item_type"],
                        row_mat,
                        row_sz,
                        row["quantity"],
                        row["weight"],
                        row["price"],
                        str(row["order_date"]),
                        u_req,
                        row["id"],
                    ),
                )
            conn.commit()
            conn.close()
            st.success("수정 완료")
            st.rerun()
